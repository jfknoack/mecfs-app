rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function configPath() {
      return /databases/$(database)/documents/config/app;
    }

    function bootstrapEmail() {
      return exists(configPath()) && 'bootstrapAdminEmail' in get(configPath()).data
        ? get(configPath()).data.bootstrapAdminEmail.lower()
        : '';
    }

    function verified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.auth.token.email_verified == true;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isBootstrapAdmin() {
      return verified() && emailKey() == bootstrapEmail();
    }

    function invitePath() {
      return /databases/$(database)/documents/allowedUsers/$(emailKey());
    }

    function inviteRole() {
      return get(invitePath()).data.role;
    }

    function inviteRoleNormalized() {
      return inviteRole() == 'patient' ? 'client' : inviteRole();
    }

    function isInvited() {
      return verified()
        && exists(invitePath())
        && inviteRoleNormalized() in ['admin', 'client'];
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isMember() {
      return hasUserDoc() && (isBootstrapAdmin() || isInvited());
    }

    function isAdmin() {
      return isMember() && (isBootstrapAdmin() || inviteRoleNormalized() == 'admin');
    }

    function isHouseholdEditor() {
      return isMember() && (isBootstrapAdmin() || inviteRoleNormalized() == 'admin' || inviteRoleNormalized() == 'client');
    }

    function isClientRole() {
      return isMember() && !isBootstrapAdmin() && inviteRoleNormalized() == 'client';
    }

    function canAccessPacing() {
      return isHouseholdEditor();
    }

    function canLogPacing() {
      return isMember() && (isBootstrapAdmin() || inviteRoleNormalized() == 'client');
    }

    function canManagePacingCatalog() {
      return isHouseholdEditor();
    }

    function validAllowedUser(emailId) {
      return request.resource.data.email == emailId
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.role in ['admin', 'client'];
    }

    function validUserDoc(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == emailKey()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.role in ['admin', 'client'];
    }

    match /config/{docId} {
      allow read: if verified() && docId == 'app';
      allow write: if false;
    }

    match /allowedUsers/{emailId} {
      allow read: if isAdmin()
        || (verified() && emailId == emailKey());

      allow create: if validAllowedUser(emailId) && (
        isAdmin()
        || (
          isBootstrapAdmin()
          && emailId == bootstrapEmail()
          && request.resource.data.role == 'admin'
        )
      );

      allow update: if isAdmin()
        && validAllowedUser(emailId)
        && !(emailId == bootstrapEmail() && request.resource.data.role != 'admin');

      allow delete: if isAdmin() && emailId != bootstrapEmail();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (verified() && request.auth.uid == uid);

      allow create: if verified()
        && request.auth.uid == uid
        && validUserDoc(uid)
        && (
          (isBootstrapAdmin() && request.resource.data.role == 'admin')
          || (isInvited() && request.resource.data.role == inviteRoleNormalized())
        );

      allow update: if (
        verified()
        && request.auth.uid == uid
        && validUserDoc(uid)
        && (
          request.resource.data.role == resource.data.role
          || (isBootstrapAdmin() && request.resource.data.role == 'admin')
          || (isInvited() && request.resource.data.role == inviteRoleNormalized())
        )
      ) || (
        isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.role in ['admin', 'client']
        && !(resource.data.email == bootstrapEmail() && request.resource.data.role != 'admin')
      );

      allow delete: if isAdmin() && resource.data.email != bootstrapEmail();
    }

    match /listNames/{nameKey} {
      allow read: if isMember() && !isClientRole();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.listId is string;
      allow delete: if isAdmin();
    }

    match /lists/{listId} {
      allow read: if isMember() && !isClientRole();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameKey is string
        && request.resource.data.icon is string
        && request.resource.data.visibility in ['public', 'private'];
      allow update, delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if isMember() && !isClientRole();
        allow create: if isAdmin()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if isAdmin()
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin();
      }
    }

    match /routines/{routineId} {
      allow read: if isMember() && !isClientRole();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.timeFrom is string
        && request.resource.data.timeTo is string
        && request.resource.data.recurrence in ['once', 'daily', 'weekly']
        && request.resource.data.weekdays is list
        && request.resource.data.weekdays.size() <= 7
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.color in [
          'magenta',
          'red',
          'purple',
          'indigo',
          'blue',
          'teal',
          'green',
          'lime',
          'yellow',
          'brown',
          'slate'
        ]
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 80;
      allow update: if (
        isAdmin()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.timeFrom is string
        && request.resource.data.timeTo is string
        && request.resource.data.recurrence in ['once', 'daily', 'weekly']
        && request.resource.data.weekdays is list
        && request.resource.data.weekdays.size() <= 7
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.color in [
          'magenta',
          'red',
          'purple',
          'indigo',
          'blue',
          'teal',
          'green',
          'lime',
          'yellow',
          'brown',
          'slate'
        ]
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 80
      ) || (
        isMember()
        && !isClientRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if isMember() && !isClientRole();
      allow create: if isAdmin()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 80
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 40;
      allow update: if isAdmin()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 80
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 40;
      allow delete: if isAdmin();
    }

    match /budgetMonths/{monthId} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.year is number
        && request.resource.data.year >= 2020
        && request.resource.data.year <= 2100
        && request.resource.data.month is number
        && request.resource.data.month >= 1
        && request.resource.data.month <= 12
        && request.resource.data.yearMonth == monthId
        && request.resource.data.incomeTotal is number
        && request.resource.data.expenseTotal is number;
      allow delete: if isAdmin();

      match /entries/{entryId} {
        allow read: if isMember();
        allow create: if isAdmin()
          && request.resource.data.kind in ['income', 'expense']
          && request.resource.data.category in [
            'pflegegeld',
            'supporter',
            'sonstiges-einkommen',
            'medikamente',
            'anschaffungen',
            'lebensmittel',
            'sonstige-ausgaben'
          ]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.icon is string
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string;
        allow delete: if isAdmin();
      }
    }

    match /pacingActivityNames/{nameKey} {
      allow read: if canAccessPacing();
      allow create: if canManagePacingCatalog()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.activityId is string;
      allow delete: if canManagePacingCatalog();
    }

    function validPacingKind(data) {
      return !('kind' in data)
        || data.kind in ['physical', 'cognitive', 'social', 'household', 'rest'];
    }

    function validEnergyCost(data) {
      return !('energyCost' in data)
        || (data.energyCost is number && data.energyCost >= 0 && data.energyCost <= 10);
    }

    match /pacingActivities/{activityId} {
      allow read: if canAccessPacing();
      allow create: if canManagePacingCatalog()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.titleKey is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && validPacingKind(request.resource.data)
        && validEnergyCost(request.resource.data);
      allow update: if canManagePacingCatalog()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.titleKey is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && validPacingKind(request.resource.data)
        && validEnergyCost(request.resource.data);
      allow delete: if canManagePacingCatalog();
    }

    match /pacingLogs/{logId} {
      allow read: if canAccessPacing();
      allow create: if canLogPacing()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && request.resource.data.activityId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.done is bool
        && request.resource.data.difficulty is number
        && request.resource.data.difficulty >= 0
        && request.resource.data.difficulty <= 10
        && validPacingKind(request.resource.data);
      allow update: if canLogPacing()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.date == resource.data.date
        && request.resource.data.activityId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.done is bool
        && request.resource.data.difficulty is number
        && request.resource.data.difficulty >= 0
        && request.resource.data.difficulty <= 10
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && validPacingKind(request.resource.data);
      allow delete: if canLogPacing();
    }

    match /pacingDays/{dayId} {
      allow read: if canAccessPacing();
      allow create, update: if canLogPacing()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.date == dayId
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.energy is number
        && request.resource.data.energy >= 0
        && request.resource.data.energy <= 10
        && request.resource.data.pem is bool
        && request.resource.data.budget is number
        && request.resource.data.budget >= 1
        && request.resource.data.budget <= 80;
      allow delete: if canLogPacing();
    }

    match /pacingSettings/{uid} {
      allow read: if canAccessPacing();
      allow create, update: if canLogPacing()
        && request.auth.uid == uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.bellScore is number
        && request.resource.data.bellScore >= 0
        && request.resource.data.bellScore <= 100;
      allow delete: if canLogPacing() && request.auth.uid == uid;
    }
  }
}
